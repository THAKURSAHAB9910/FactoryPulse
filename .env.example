# FactoryPulse Platform Environment Configuration

# Application
ENVIRONMENT=production
APP_NAME=FactoryPulse
DEBUG=False
SECRET_KEY=factorypulse_super_secret_jwt_key_manufacturing_intelligence_2026

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=factorypulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/factorypulse

# Local / Direct Database connection (for host-based scripts)
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/factorypulse

# FastAPI Backend
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Apache Superset
SUPERSET_SECRET_KEY=superset_secret_key_factorypulse_production_secure_2026
SUPERSET_PORT=8088
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@factorypulse.io

# Simulator
SIMULATOR_TARGET_EVENTS=500000
SIMULATOR_BATCH_SIZE=25000
SIMULATOR_START_DATE=2026-08-01
SIMULATOR_END_DATE=2026-09-17
